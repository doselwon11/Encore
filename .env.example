# Copy to .env.local. Keep real credentials out of source control.
# Set this locally/server-side. Never use NEXT_PUBLIC_OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Enable only after configuring your key and deployment controls.
AI_CREATE_ENABLED=false
# Set to the exact public origin when deployed (no trailing slash).
# APP_ORIGIN=https://your-encore.example
